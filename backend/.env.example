# Backend Server Configuration
PORT=5000

# Database Mode Configuration
# Set to 'true' to use standalone mock JSON files in backend/data (no MySQL required)
# Set to 'false' to connect to real MySQL/MariaDB database
USE_FILE_DB=true

# Database Connection (MySQL / MariaDB / Cloud DB - active when USE_FILE_DB=false)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ascg_g_db

# Security & JWT Token
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=8h

# ZKTeco SpeedFace-V3L Scanner Configuration
ZKTECO_IP=192.168.99.7
ZKTECO_PORT=4370
